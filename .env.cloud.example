APP_NAME="ChiliVision"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://USERNAME-chilivision.hf.space

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database Online MySQL Gratis Tanpa Kartu Kredit: TiDB Cloud Starter (tidbcloud.com)
# Salin Host, Port (4000), Username, dan Password dari tombol "Connect" di dashboard TiDB Cloud.
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=chilivision_db
DB_USERNAME=
DB_PASSWORD=
# Di container Render/Docker (Linux): /etc/ssl/certs/ca-certificates.crt
# Di Windows lokal: arahkan ke path file isrgrootx1.pem yang diunduh dari TiDB Cloud
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Wajib pakai database agar session/cache/threshold aman di hosting container
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Jalankan inferensi ONNX Runtime CLI (ringan untuk container Docker gratis)
FASTAPI_INFERENCE_ENABLED=false
FASTAPI_INFERENCE_URL=http://127.0.0.1:8001

# Chatbot Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Set true saat deploy awal agar php artisan migrate --force jalan otomatis
RUN_MIGRATIONS=true
