APP_NAME="ChiliVision Smart Crop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chilivision_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Computer Vision & IoT Settings (ONNX Models Integrated in Laravel)
DATASET_SOURCE="C:/Users/62821/OneDrive/Desktop/Semester 5/Project/Dataset/Chilli Plant Diseases Dataset(Augmented)/Chilli Plant Diseases Dataset/train"
MODEL_PATH=models/cnn_5ch_7kelas_hard_negative.keras
CLASS_NAMES_PATH=models/cnn_5ch_7kelas_hard_negative.names.json
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.70

# Telegram Bot Integration (@chili_vision_bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI Chatbot Integration (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# FastAPI Warm Inference Worker (opsional; otomatis fallback ke inference_cli.py jika mati)
FASTAPI_INFERENCE_ENABLED=true
FASTAPI_INFERENCE_URL=http://127.0.0.1:8001
FASTAPI_INFERENCE_TIMEOUT=15

# Cloudflare Named Tunnel (opsional: isi token tunnel jika memakai domain tetap)
CLOUDFLARED_PUBLIC_URL=
CLOUDFLARED_TUNNEL_TOKEN=
